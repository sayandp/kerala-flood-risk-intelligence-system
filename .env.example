# ============================================
# Kerala Flood Risk Scorer - Environment Variables
# ============================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is gitignored — never commit it.

# --- Google Earth Engine ---------------------
# Your Google Cloud project ID with the Earth Engine API enabled.
# Only needed to re-run the pipelines/ scripts, not to serve the API.
# Authentication itself uses your local credential cache — run
# `earthengine authenticate` once; no key belongs in this file.
GEE_PROJECT_ID=your-gcp-project-id

# --- Server ----------------------------------
# Bind address for the backend. Use HOST=0.0.0.0 only if you need to reach
# the API from another machine on your network.
HOST=127.0.0.1
PORT=8001

# --- CORS ------------------------------------
# Comma-separated list of origins allowed to call the backend.
# Defaults to the local Vite dev server if unset.
# In production set this to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Geocoding -------------------------------
# Nominatim is free and needs no key, but its usage policy requires
# a descriptive User-Agent identifying your app.
NOMINATIM_USER_AGENT=kerala_flood_risk_app

# --- Optional: Mapbox basemaps ---------------
# MAPBOX_TOKEN=your-mapbox-token-here

# --- App settings ----------------------------
APP_NAME=Kerala Flood Risk Scorer
APP_VERSION=1.0.0
